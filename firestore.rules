rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // ACARPEN MULTI-TENANT & ROLE ISOLATION SECURITY RULES
    // =========================================================================
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function me() {
      return get(userDocPath()).data;
    }

    function isSameTenant(data) {
      return !('tenantId' in data) || data.tenantId == 'acarpen';
    }

    function incomingTenantValid() {
      return !('tenantId' in request.resource.data) || request.resource.data.tenantId == 'acarpen';
    }

    function isStaff() {
      return signedIn()
        && exists(userDocPath())
        && me().active == true
        && isSameTenant(me());
    }

    // Enforce real-time role strictly from active Firestore users/{uid};
    // stale JWT custom claims must never bypass revocation or role downgrade.
    function hasRole(roles) {
      return isStaff() && (me().role in roles);
    }

    function isYonetici() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager']);
    }

    function isAdminOrStaff() {
      return hasRole([
        'yonetici',
        'satis_yoneticisi',
        'satis',
        'uretim_planlama',
        'operator',
        'kalite',
        'depo_satinalma',
        'finans',
        'superadmin',
        'super_admin',
        'manager',
        'sales',
        'editor'
      ]);
    }

    function canSell() {
      return hasRole(['yonetici', 'satis_yoneticisi', 'satis', 'sales', 'editor', 'superadmin', 'super_admin', 'manager']);
    }

    function canEditPrices() {
      return hasRole(['yonetici', 'satis_yoneticisi', 'superadmin', 'super_admin', 'manager']);
    }

    function canAdjustStock() {
      return hasRole(['yonetici', 'depo_satinalma', 'uretim_planlama', 'superadmin', 'super_admin', 'manager']);
    }

    function canManageQuality() {
      return hasRole(['yonetici', 'kalite', 'uretim_planlama', 'superadmin', 'super_admin', 'manager']);
    }

    function canReleaseQualityHold() {
      return hasRole(['yonetici', 'kalite', 'superadmin', 'super_admin', 'manager']);
    }

    function canManageProduction() {
      return hasRole(['yonetici', 'uretim_planlama', 'operator', 'kalite', 'superadmin', 'super_admin', 'manager']);
    }

    function canManagePurchases() {
      return hasRole(['yonetici', 'depo_satinalma', 'uretim_planlama', 'satis_yoneticisi', 'finans', 'superadmin', 'super_admin', 'manager']);
    }

    function canManageFinance() {
      return hasRole(['yonetici', 'finans', 'satis_yoneticisi', 'superadmin', 'super_admin', 'manager']);
    }

    function isAssignedOrOwnerless(data) {
      return hasRole(['yonetici', 'satis_yoneticisi', 'finans', 'superadmin', 'super_admin', 'manager', 'editor'])
        || !('assignedToUid' in data)
        || data.assignedToUid == ''
        || data.assignedToUid == request.auth.uid
        || data.get('createdByUid', '') == request.auth.uid;
    }

    function validDiscountState(data) {
      return data.get('discountRate', 0) <= 10
        || data.get('approvalStatus', 'approved') == 'pending_approval'
        || canEditPrices()
        || isYonetici();
    }

    function validQuoteReleaseTransition() {
      return (resource.data.get('qualityHold', false) == false
        || (request.resource.data.get('status', '') != 'completed'
            && request.resource.data.get('productionStage', 1) < 5)
        || (request.resource.data.get('qualityHold', true) == false && canReleaseQualityHold()));
    }

    function validProductionReleaseTransition() {
      return (resource.data.get('qualityHold', false) == false
        || (request.resource.data.get('status', '') != 'completed'
            && request.resource.data.get('productionStage', 1) < 5)
        || (request.resource.data.get('qualityHold', true) == false && canReleaseQualityHold()));
    }

    // -------------------------------------------------------------------------
    // 1. Staff Role & Tenant Directory (Manageable strictly by active yonetici)
    // -------------------------------------------------------------------------
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid && isSameTenant(resource.data);
      allow list: if isYonetici();
      allow write: if isYonetici() && incomingTenantValid();
    }

    // -------------------------------------------------------------------------
    // 2. Sensitive Quotes, Financials & PII (Sales + Finance; Sales Reps scoped)
    // -------------------------------------------------------------------------
    match /acarpen_quotes/{id} {
      allow list: if canSell() || canManageFinance();
      allow get: if (canSell() || canManageFinance())
        && isSameTenant(resource.data)
        && isAssignedOrOwnerless(resource.data);
      allow create: if canSell()
        && incomingTenantValid()
        && validDiscountState(request.resource.data);
      allow update: if (canSell() || canManageFinance())
        && isSameTenant(resource.data)
        && incomingTenantValid()
        && isAssignedOrOwnerless(resource.data)
        && validDiscountState(request.resource.data)
        && validQuoteReleaseTransition();
      allow delete: if isYonetici();
    }

    // -------------------------------------------------------------------------
    // 3. Sanitized Production Orders (Workshop Roles - Zero Customer PII/Pricing)
    // -------------------------------------------------------------------------
    match /acarpen_production_orders/{id} {
      allow list: if isAdminOrStaff();
      allow get: if isAdminOrStaff() && isSameTenant(resource.data);
      allow create, update: if (canSell() || canManageProduction())
        && incomingTenantValid()
        && !('estimatedPrice' in request.resource.data)
        && !('customerName' in request.resource.data)
        && !('phone' in request.resource.data)
        && !('email' in request.resource.data)
        && !('paidAmount' in request.resource.data)
        && (!exists(/databases/$(database)/documents/acarpen_production_orders/$(id))
            || validProductionReleaseTransition());
      allow delete: if isYonetici();
    }

    // -------------------------------------------------------------------------
    // 4. Two-Factor Hash-Keyed Order Tracking Projections (Public GET Only)
    // -------------------------------------------------------------------------
    match /acarpen_order_tracking/{id} {
      allow get: if id.matches('^(ORDER|PHONE)_[a-f0-9]{64}$');
      allow list: if false;
      allow create, update: if isAdminOrStaff() && id.matches('^(ORDER|PHONE)_[a-f0-9]{64}$');
      allow delete: if isYonetici();
    }

    // -------------------------------------------------------------------------
    // 5. Public Rate-Limit Buckets (Cloud Functions Admin SDK Only)
    // -------------------------------------------------------------------------
    match /acarpen_rate_limits/{id} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // 6. CRM Messages, Customers, Opportunities & Activities
    // -------------------------------------------------------------------------
    match /acarpen_messages/{id} {
      allow list: if canSell();
      allow get: if canSell()
        && isSameTenant(resource.data)
        && isAssignedOrOwnerless(resource.data);
      allow create, update: if canSell()
        && incomingTenantValid()
        && (!exists(/databases/$(database)/documents/acarpen_messages/$(id))
            || isAssignedOrOwnerless(resource.data));
      allow delete: if isYonetici();
    }

    match /acarpen_customers/{id} {
      allow list: if canSell() || canManageFinance();
      allow get: if (canSell() || canManageFinance())
        && isSameTenant(resource.data)
        && isAssignedOrOwnerless(resource.data);
      allow create: if (canSell() || canManageFinance()) && incomingTenantValid();
      allow update: if (canSell() || canManageFinance())
        && isSameTenant(resource.data)
        && incomingTenantValid()
        && isAssignedOrOwnerless(resource.data);
      allow delete: if isYonetici();
    }

    match /acarpen_opportunities/{id} {
      allow list: if canSell();
      allow get: if canSell()
        && isSameTenant(resource.data)
        && isAssignedOrOwnerless(resource.data);
      allow create: if canSell() && incomingTenantValid();
      allow update: if canSell()
        && isSameTenant(resource.data)
        && incomingTenantValid()
        && isAssignedOrOwnerless(resource.data);
      allow delete: if isYonetici();
    }

    match /acarpen_activities/{id} {
      allow list: if canSell();
      allow get: if canSell()
        && isSameTenant(resource.data)
        && isAssignedOrOwnerless(resource.data);
      allow create: if canSell() && incomingTenantValid();
      allow update: if canSell()
        && isSameTenant(resource.data)
        && incomingTenantValid()
        && isAssignedOrOwnerless(resource.data);
      allow delete: if isYonetici();
    }

    // -------------------------------------------------------------------------
    // 7. Prices, Services, Inventory, Purchasing, Quality, Finance & Audit
    // -------------------------------------------------------------------------
    match /acarpen_prices/{id} {
      allow list: if isAdminOrStaff();
      allow get: if isAdminOrStaff() && isSameTenant(resource.data);
      allow write: if canEditPrices() && incomingTenantValid();
    }

    match /acarpen_services/{id} {
      allow list: if isAdminOrStaff();
      allow get: if isAdminOrStaff() && isSameTenant(resource.data);
      allow write: if canEditPrices() && incomingTenantValid();
    }

    match /acarpen_inventory/{id} {
      allow list: if isAdminOrStaff();
      allow get: if isAdminOrStaff() && isSameTenant(resource.data);
      allow write: if canAdjustStock() && incomingTenantValid();
    }

    match /acarpen_purchases/{id} {
      allow list: if canManagePurchases();
      allow get: if canManagePurchases() && isSameTenant(resource.data);
      allow write: if canManagePurchases() && incomingTenantValid();
    }

    match /acarpen_quality/{id} {
      allow list: if isAdminOrStaff();
      allow get: if isAdminOrStaff() && isSameTenant(resource.data);
      allow create, update: if canManageQuality() && incomingTenantValid();
      allow delete: if isYonetici();
    }

    match /acarpen_checks/{id} {
      allow list: if canManageFinance();
      allow get: if canManageFinance() && isSameTenant(resource.data);
      allow write: if canManageFinance() && incomingTenantValid();
    }

    match /acarpen_cash_ledger/{id} {
      allow list: if canManageFinance();
      allow get: if canManageFinance() && isSameTenant(resource.data);
      allow write: if canManageFinance() && incomingTenantValid();
    }

    match /acarpen_audit_logs/{id} {
      allow list: if hasRole(['yonetici', 'finans', 'kalite', 'superadmin', 'super_admin', 'manager']);
      allow get: if hasRole(['yonetici', 'finans', 'kalite', 'superadmin', 'super_admin', 'manager'])
        && isSameTenant(resource.data);
      allow create: if isAdminOrStaff()
        && incomingTenantValid()
        && request.resource.data.get('actorUid', request.auth.uid) == request.auth.uid;
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Default-deny every other collection path
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
