rules_version = '2';

// Acar Pen — "acarpen" adlı Firestore veritabanına dağıtılır (firebase.json).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function me() {
      return get(userDocPath()).data;
    }

    function isStaff() {
      return signedIn()
        && exists(userDocPath())
        && me().active == true;
    }

    function hasRole(roles) {
      return isStaff() && (
        (me().role in roles)
        || (('acarpenRole' in request.auth.token) && (request.auth.token.acarpenRole in roles))
      );
    }

    function isAdminOrStaff() {
      return isStaff() && (
        me().role in [
          'yonetici', 'satis_yoneticisi', 'satis', 'uretim_planlama',
          'operator', 'kalite', 'depo_satinalma', 'finans',
          'superadmin', 'super_admin', 'manager', 'sales', 'editor'
        ]
        || (('acarpenRole' in request.auth.token) && (request.auth.token.acarpenRole in [
          'yonetici', 'satis_yoneticisi', 'satis', 'uretim_planlama',
          'operator', 'kalite', 'depo_satinalma', 'finans'
        ]))
      );
    }

    // Rol matrisi — adminStorage ROLE_DEFINITIONS + eski alias'lar
    function isYonetici() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager']);
    }
    function canManage() {
      return isYonetici();
    }
    function canSell() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'satis_yoneticisi', 'satis', 'sales', 'editor']);
    }
    function canEdit() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'satis_yoneticisi', 'editor']);
    }
    function canEditPrices() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'satis_yoneticisi']);
    }
    function canManageProduction() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'uretim_planlama', 'operator']);
    }
    function canInspectQuality() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'uretim_planlama', 'operator', 'kalite', 'depo_satinalma']);
    }
    function canManageQualityHold() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'kalite']);
    }
    function canManageInventory() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'depo_satinalma']);
    }
    function canManageFinance() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'finans', 'satis_yoneticisi']);
    }
    function canManageChecksAndCash() {
      return hasRole(['yonetici', 'superadmin', 'super_admin', 'manager', 'finans']);
    }

    // Anonim istemci doğrudan teklif, mesaj veya takip yazamaz; tüm halka açık formlar
    // hız sınırlamalı acarpenSubmitPublicLead Cloud Function (Admin SDK) üzerinden işlenir.
    // Yayınlanan içerik herkese açık; taslaklar yalnızca içerik yetkililerine.
    match /services/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /projects/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /blogPosts/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /faq/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if canManage();
    }

    // CRM: yalnızca yetkili satış/yönetim personeli okuyup yazabilir.
    match /leads/{id} {
      allow read, create, update: if canSell();
      allow delete: if canManage();
    }
    match /leadNotes/{id} {
      allow read: if canSell();
      allow create: if canSell() && request.resource.data.authorId == request.auth.uid;
      allow delete: if canManage();
    }
    match /quotes/{id} {
      allow read, create, update: if canSell();
      allow delete: if canManage();
    }

    // Acarpen ERP Canlı Koleksiyonları — PII/finans ve atölye verileri rol bazlı ayrıştırılmıştır
    match /acarpen_quotes/{id} {
      allow get, list: if canSell() || canManageFinance();
      allow create: if canSell();
      allow update: if canSell() || canManageFinance();
      allow delete: if isYonetici();
    }

    // Müşteri PII ve maliyet/fiyat alanları içermeyen atölye üretim ve sevkiyat projeksiyonu
    match /acarpen_production_orders/{id} {
      allow get, list: if isAdminOrStaff();
      allow create: if canSell()
        && !request.resource.data.keys().hasAny([
          'phone', 'email', 'customerName', 'city', 'deliveryAddress',
          'estimatedPrice', 'estimatedCost', 'actualCost', 'discountRate',
          'paidAmount', 'invoiceNo', 'waybillNo'
        ]);
      allow update: if (canSell() || canManageProduction() || canManageQualityHold() || hasRole(['depo_satinalma']))
        && (
          request.resource.data.get('qualityHold', false) == resource.data.get('qualityHold', false)
          || canManageQualityHold()
          || isYonetici()
        )
        && !request.resource.data.keys().hasAny([
          'phone', 'email', 'customerName', 'city', 'deliveryAddress',
          'estimatedPrice', 'estimatedCost', 'actualCost', 'discountRate',
          'paidAmount', 'invoiceNo', 'waybillNo'
        ]);
      allow delete: if isYonetici();
    }

    // İki faktörlü (Sipariş/Telefon + 6 haneli PIN) SHA-256 anahtarlı takip projeksiyonu
    match /acarpen_order_tracking/{id} {
      allow get: if id.matches('^(ORDER|PHONE)_[a-f0-9]{64}$');
      allow list: if false;
      allow create, update: if canSell() || canManageProduction() || canManageQualityHold();
      allow delete: if isYonetici();
    }

    match /acarpen_rate_limits/{id} {
      allow read, write: if false;
    }

    match /acarpen_messages/{id} {
      allow read, create, update: if canSell();
      allow delete: if isYonetici();
    }

    match /acarpen_prices/{id} {
      allow read: if isAdminOrStaff();
      allow write: if canEditPrices();
    }
    match /acarpen_services/{id} {
      allow read: if isAdminOrStaff();
      allow write: if canEditPrices();
    }
    match /acarpen_customers/{id} {
      allow read: if canSell() || canManageFinance();
      allow create, update: if canSell();
      allow delete: if isYonetici();
    }
    match /acarpen_opportunities/{id} {
      allow read, create, update: if canSell();
      allow delete: if isYonetici();
    }
    match /acarpen_activities/{id} {
      allow read, create, update: if canSell();
      allow delete: if isYonetici();
    }
    match /acarpen_inventory/{id} {
      allow read: if isAdminOrStaff();
      allow create, update: if canManageInventory();
      allow delete: if isYonetici();
    }
    match /acarpen_purchases/{id} {
      allow read: if canSell() || canManageInventory() || hasRole(['uretim_planlama', 'finans']);
      allow create, update: if canManageInventory();
      allow delete: if isYonetici();
    }
    match /acarpen_quality/{id} {
      allow read: if isAdminOrStaff();
      allow create, update: if canInspectQuality();
      allow delete: if isYonetici();
    }
    match /acarpen_checks/{id} {
      allow read: if canManageFinance();
      allow create, update: if canManageChecksAndCash();
      allow delete: if isYonetici();
    }
    match /acarpen_cash_ledger/{id} {
      allow read: if canManageFinance();
      allow create, update: if canManageChecksAndCash();
      allow delete: if isYonetici();
    }
    match /acarpen_audit_logs/{id} {
      allow read: if isYonetici() || hasRole(['finans', 'kalite']);
      allow create: if isAdminOrStaff();
      allow update, delete: if false;
    }

    match /media/{id} {
      allow read, write: if canEdit();
    }
    match /contentVersions/{id} {
      allow read, create: if canEdit();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isYonetici());
      allow write: if isYonetici();
    }

    match /auditLogs/{id} {
      allow read: if canManage();
      allow create: if isStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
