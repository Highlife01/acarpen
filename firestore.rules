rules_version = '2';

// Acar Pen — "acarpen" adlı Firestore veritabanına dağıtılır (firebase.json).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isPrimaryAdmin() {
      return signedIn() && request.auth.token.email == 'admin@acarpen.com.tr';
    }
    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().active == true;
    }
    function hasRole(roles) {
      return isPrimaryAdmin() || (isStaff() && me().role in roles);
    }
    function isAdminOrStaff() {
      return isPrimaryAdmin() || isStaff();
    }
    function canManage() { return hasRole(['superadmin', 'manager']); }
    function canSell() { return hasRole(['superadmin', 'manager', 'sales']); }
    function canEdit() { return hasRole(['superadmin', 'manager', 'editor']); }

    function optString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    function validLead() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'type', 'name', 'phone', 'phoneNormalized', 'email', 'city', 'district', 'neighborhood',
          'serviceId', 'projectType', 'dimensions', 'message', 'attachments', 'contactMethod',
          'source', 'utm', 'landingPage', 'referrer', 'status', 'assignedTo', 'consent',
          'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll(['type', 'name', 'phone', 'phoneNormalized', 'serviceId', 'status', 'consent', 'createdAt', 'updatedAt'])
        && d.type in ['quote', 'survey', 'contact']
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 24
        && d.phoneNormalized is string && d.phoneNormalized.matches('^[+][0-9]{10,15}$')
        && d.serviceId is string && d.serviceId.size() <= 80
        && d.status == 'new'
        && (!('assignedTo' in d) || d.assignedTo == null)
        && d.consent is map && d.consent.noticeAccepted == true
        && d.createdAt == request.time && d.updatedAt == request.time
        && optString(d, 'email', 120)
        && optString(d, 'city', 40)
        && optString(d, 'district', 40)
        && optString(d, 'neighborhood', 80)
        && optString(d, 'projectType', 20)
        && optString(d, 'message', 2000)
        && optString(d, 'contactMethod', 20)
        && optString(d, 'source', 40)
        && optString(d, 'landingPage', 300)
        && optString(d, 'referrer', 300)
        && (!('dimensions' in d) || d.dimensions is map)
        && (!('utm' in d) || (d.utm is map && d.utm.size() <= 6))
        && (!('attachments' in d) || (d.attachments is list && d.attachments.size() <= 5));
    }

    function validPublicQuote() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'customerName', 'phone', 'status'])
        && d.id is string && d.id.size() >= 5 && d.id.size() <= 64
        && d.customerName is string && d.customerName.size() >= 1 && d.customerName.size() <= 120
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 32
        && d.status == 'new';
    }

    function validPublicMessage() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'name', 'phone', 'subject', 'message'])
        && d.id is string && d.id.size() >= 5 && d.id.size() <= 64
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 120
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 32
        && d.subject is string && d.subject.size() <= 200
        && d.message is string && d.message.size() <= 3000;
    }

    // Yayınlanan içerik herkese açık; taslaklar yalnızca içerik yetkililerine.
    match /services/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /projects/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /blogPosts/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /faq/{id} {
      allow read: if resource.data.status == 'published' || canEdit();
      allow write: if canEdit();
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if canManage();
    }

    // CRM: ziyaretçi yalnızca doğrulanmış biçimde yeni talep oluşturabilir, liste okuyamaz.
    match /leads/{id} {
      allow create: if validLead();
      allow read, update: if canSell();
      allow delete: if canManage();
    }
    match /leadNotes/{id} {
      allow read: if canSell();
      allow create: if canSell() && request.resource.data.authorId == request.auth.uid;
      allow delete: if canManage();
    }
    match /quotes/{id} {
      allow read, create, update: if canSell();
      allow delete: if canManage();
    }

    // Acarpen ERP Canlı Koleksiyonları (adminStorage.ts COLLECTIONS ile birebir uyumlu)
    match /acarpen_quotes/{id} {
      allow get: if true;
      allow list, update, delete: if isAdminOrStaff();
      allow create: if isAdminOrStaff() || validPublicQuote();
    }
    match /acarpen_messages/{id} {
      allow read, update, delete: if isAdminOrStaff();
      allow create: if isAdminOrStaff() || validPublicMessage();
    }
    match /acarpen_prices/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_services/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_customers/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_opportunities/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_activities/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_inventory/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_purchases/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_quality/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_checks/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_cash_ledger/{id} {
      allow read, write: if isAdminOrStaff();
    }
    match /acarpen_audit_logs/{id} {
      allow read, create: if isAdminOrStaff();
      allow update, delete: if false;
    }

    match /media/{id} {
      allow read, write: if canEdit();
    }
    match /contentVersions/{id} {
      allow read, create: if canEdit();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdminOrStaff());
      allow write: if hasRole(['superadmin']);
    }

    match /auditLogs/{id} {
      allow read: if canManage();
      allow create: if isStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
