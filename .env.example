# Firebase web uygulaması yapılandırması (Firebase Console > Proje ayarları > Uygulamalarınız)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Adlandırılmış Firestore veritabanı. Varsayılan veritabanı için boş bırakın.
VITE_FIREBASE_DATABASE_ID=acarpen
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Canonical ve sitemap için yayın adresi (sonunda / olmadan)
VITE_SITE_URL=https://acarpen.com.tr

# İsteğe bağlı entegrasyonlar
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
# reCAPTCHA v3 site anahtarı girilirse App Check etkinleşir
VITE_APPCHECK_SITE_KEY=
# Storage kuralları kurulduktan sonra true yapın (docs/KURULUM.md)
VITE_ENABLE_UPLOADS=false
