{
  "firestore": [
    {
      "database": "acarpen",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "hosting": {
    "site": "acarpen",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/pvc-pencere", "destination": "/urunler/cift-cam", "type": 301 },
      { "source": "/pvc-pencere-sistemleri", "destination": "/urunler/cift-cam", "type": 301 },
      { "source": "/firatpen-pvc-pencere", "destination": "/urunler/cift-cam", "type": 301 },
      { "source": "/firatpen-selenit-75", "destination": "/urunler/cift-cam", "type": 301 },
      { "source": "/firatpen-elegance-80", "destination": "/urunler/cift-cam", "type": 301 },
      { "source": "/firatpen-redonit-85", "destination": "/urunler/cift-cam", "type": 301 },
      { "source": "/pvc-surme", "destination": "/urunler/temperli-cam", "type": 301 },
      { "source": "/pvc-surme-kapi", "destination": "/urunler/temperli-cam", "type": 301 },
      { "source": "/hebeschiebe-surme-sistemleri", "destination": "/urunler/temperli-cam", "type": 301 },
      { "source": "/cam-balkon", "destination": "/urunler/balkon-cami", "type": 301 },
      { "source": "/katlanir-cam-balkon", "destination": "/urunler/balkon-cami", "type": 301 },
      { "source": "/surme-cam-balkon", "destination": "/urunler/balkon-cami", "type": 301 },
      { "source": "/giyotin-cam-balkon", "destination": "/urunler/balkon-cami", "type": 301 },
      { "source": "/pvc-kapi", "destination": "/urunler/jaluzili-isicam", "type": 301 },
      { "source": "/pvc-kapi-sistemleri", "destination": "/urunler/jaluzili-isicam", "type": 301 },
      { "source": "/panjur-sistemleri", "destination": "/urunler/jaluzili-isicam", "type": 301 },
      { "source": "/pvc-renkler", "destination": "/urunler/renkli-camlar", "type": 301 },
      { "source": "/renkli-pvc-pencere", "destination": "/urunler/renkli-camlar", "type": 301 },
      { "source": "/antrasit-pvc-pencere", "destination": "/urunler/renkli-camlar", "type": 301 },
      { "source": "/plise-sineklik", "destination": "/urunler/lamine-cam", "type": 301 },
      { "source": "/toplu-proje-pvc-dograma", "destination": "/urunler/dis-cephe-camlari", "type": 301 },
      { "source": "/isi-yalitimli-pvc-pencere", "destination": "/rehber", "type": 301 },
      { "source": "/pvc-pencere-fiyat-hesaplama", "destination": "/hesaplama", "type": 301 },
      { "source": "/teklif-al", "destination": "/hesaplama", "type": 301 },
      { "source": "/referanslar", "destination": "/projeler", "type": 301 },
      { "source": "/projeler/mersin-tower-plaza", "destination": "/projeler/cukurova-prestij-konutlari", "type": 301 },
      { "source": "/projeler/gaziantep-osb-tekstil-fabrikasi", "destination": "/projeler/cukurova-prestij-konutlari", "type": 301 },
      { "source": "/uretim-ve-kalite", "destination": "/uretim-teknolojisi", "type": 301 },
      { "source": "/adana-firatpen-bayisi", "destination": "/bolgeler/adana-cam-fabrikasi", "type": 301 },
      { "source": "/bolgeler/adana", "destination": "/bolgeler/adana-cam-fabrikasi", "type": 301 },
      { "source": "/bolgeler/mersin", "destination": "/bolgeler/mersin-cam-imalati", "type": 301 },
      { "source": "/bolgeler/osmaniye", "destination": "/bolgeler/osmaniye-cam-ureticisi", "type": 301 },
      { "source": "/bolgeler/hatay", "destination": "/bolgeler/hatay-cam-firmalari", "type": 301 },
      { "source": "/bolgeler/gaziantep", "destination": "/bolgeler/gaziantep-cam-cozumleri", "type": 301 },
      { "source": "/bolgeler/kayseri", "destination": "/bolgeler/kayseri-cam-toptan", "type": 301 },
      { "source": "/bolgeler/nigde", "destination": "/bolgeler/nigde-cam-sevkiyati", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://wa.me; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://translate.google.com https://translate.googleapis.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://www.gstatic.com https://translate.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://*.run.app https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://translate.googleapis.com https://translate-pa.googleapis.com https://www.google.com https://www.gstatic.com; frame-src 'self' https://www.google.com https://maps.google.com https://translate.google.com; upgrade-insecure-requests"
          },
          {
            "key": "Link",
            "value": "<https://www.acarpen.com.tr/llms.txt>; rel=\"llms-txt\", <https://www.acarpen.com.tr/llms-full.txt>; rel=\"llms-full-txt\""
          }
        ]
      },
      {
        "source": "/admin**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/@(llms.txt|llms-full.txt|ai.txt)",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/entity.jsonld",
        "headers": [
          { "key": "Content-Type", "value": "application/ld+json; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ],
    "rewrites": []
  }
}
